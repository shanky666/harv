# App Configuration
APP_NAME=HarvestLenz
APP_ENV=development
SECRET_KEY=change-this-to-a-secure-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Development default: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./test_db.sqlite

# Storage Configuration (local or s3)
STORAGE_TYPE=local
STORAGE_BASE_PATH=storage

# AI Models Configuration
YOLO_MODEL_PATH=models/yolo_v1.pt
CNN_MODEL_PATH=models/fruit_grader_v1.h5
CLASSIFIER_MODEL_PATH=models/fruit_classifier.h5
YOLO_CONFIDENCE=0.5

# Demo Mode (Bypasses authentication for FYP demonstrations/testing)
DEMO_MODE=true

# Logging Configuration
LOG_LEVEL=INFO
